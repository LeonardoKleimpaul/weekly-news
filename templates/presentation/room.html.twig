{% extends 'base.html.twig' %}
{% block title %}Apresentação · {{ friday|date('d/m/Y', false) }} · Weekly News{% endblock %}
{% block scripts %}<script src="{{ asset('scripts/presentation.js') }}" defer></script>{% endblock %}
{% block body %}
    <section class="intro submission-heading">
    </section>
    <div data-presentation-room data-state-url="{{ path('app_presentation_state', {friday: friday|date('Y-m-d', false)}) }}">
        {% include 'presentation/_state.html.twig' %}
    </div>
    <p class="small muted room-connection" role="status" aria-live="polite" data-room-connection>{{ presentation and presentation.finished ? 'Apresentação concluída.' : 'Atualização automática ativa.' }}</p>
    <noscript><p class="notice">Atualize a página para acompanhar o início e a próxima história.</p></noscript>
{% endblock %}
