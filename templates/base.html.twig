<!DOCTYPE html>
{% import 'components/icons.html.twig' as icons %}
{% set current_route = app.request.attributes.get('_route') %}
<html lang="pt-BR" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Weekly News{% endblock %}</title>
    <script src="{{ asset('scripts/theme.js') }}"></script>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <script src="{{ asset('scripts/navigation.js') }}" defer></script>
    {% block scripts %}{% endblock %}
</head>
<body class="{{ app.user ? 'authenticated' : 'guest' }}">
    <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
    {% if app.user %}
        <dialog class="sidebar" id="site-sidebar" aria-labelledby="sidebar-title" open>
            <div class="sidebar-header">
                <a class="brand" href="{{ path('app_home') }}"><span class="brand-mark">w.</span><span id="sidebar-title">weekly<span class="brand-accent">news</span></span></a>
                <button class="icon-button sidebar-toggle" type="button" data-collapse-menu aria-controls="site-sidebar" aria-expanded="true" aria-label="Recolher menu" title="Recolher menu">{{ icons.icon('chevron_left') }}</button>
                <button class="icon-button sidebar-close" type="button" data-close-menu aria-label="Fechar menu">{{ icons.icon('close') }}</button>
            </div>
            <p class="nav-label">O nosso espaço</p>
            <nav class="sidebar-nav" aria-label="Menu principal">
                <a href="{{ path('app_home') }}" aria-label="Sextas" title="Sextas" {% if current_route starts with 'app_home' or current_route == 'app_submission' or 'presentation' in current_route %}aria-current="page"{% endif %}>{{ icons.icon('calendar') }}<span>Sextas</span></a>
                <a href="{{ path('app_ranking') }}" aria-label="Ranking geral" title="Ranking geral" {% if current_route == 'app_ranking' %}aria-current="page"{% endif %}>{{ icons.icon('trophy') }}<span>Ranking geral</span></a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_user_index') }}" aria-label="Usuários" title="Usuários" {% if current_route starts with 'admin_user_' %}aria-current="page"{% endif %}>{{ icons.icon('users') }}<span>Usuários</span></a>
                {% endif %}
                <a href="{{ path('app_account') }}" aria-label="Minha conta" title="Minha conta" {% if current_route == 'app_account' %}aria-current="page"{% endif %}>{{ icons.icon('user') }}<span>Minha conta</span></a>
            </nav>
            <div class="sidebar-bottom">
                <div class="member-card">
                    <span class="avatar" aria-hidden="true">{{ app.user.name|slice(0, 1)|upper }}</span>
                    <div class="member-info"><strong>{{ app.user.name }}</strong><small>{{ is_granted('ROLE_ADMIN') ? 'Administrador' : 'Membro do grupo' }}</small></div>
                    <form action="{{ path('app_logout') }}" method="post">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button class="icon-button" type="submit" aria-label="Sair" title="Sair">{{ icons.icon('logout') }}<span class="sr-only">Sair</span></button>
                    </form>
                </div>
            </div>
        </dialog>
    {% endif %}
    <div class="page-shell">
        <header class="site-header">
            {% if app.user %}
                <button class="icon-button menu-toggle" type="button" aria-controls="site-sidebar" aria-expanded="false" aria-haspopup="dialog" aria-label="Abrir menu" data-open-menu>{{ icons.icon('menu') }}</button>
                <span class="header-label">{{ current_route starts with 'admin_user_' ? 'Administração / Usuários' : (current_route == 'app_account' ? 'Minha conta' : 'O nosso espaço') }}</span>
            {% else %}
                <a class="brand" href="{{ path('app_login') }}"><span class="brand-mark">w.</span><span>weekly<span class="brand-accent">news</span></span></a>
            {% endif %}
            <div class="header-actions">
                <button class="icon-button theme-toggle" type="button" data-toggle-theme aria-label="Ativar modo claro" title="Ativar modo claro" hidden>
                    <span class="theme-icon-light">{{ icons.icon('sun') }}</span>
                    <span class="theme-icon-dark">{{ icons.icon('moon') }}</span>
                </button>
            </div>
        </header>
    <main id="main-content" tabindex="-1">
        {% for message in app.flashes('success') %}<div class="notice" role="status">{{ message }}</div>{% endfor %}
        {% for message in app.flashes('error') %}<div class="error" role="alert">{{ message }}</div>{% endfor %}
        {% block body %}{% endblock %}
    </main>
    <footer>Weekly News · O arquivo das sextas.</footer>
    </div>
</body>
</html>
